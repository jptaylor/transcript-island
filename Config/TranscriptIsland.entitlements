<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow microphone input. The app is not sandboxed, because
	     typing into other apps uses the Accessibility API and synthesized ⌘V. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
